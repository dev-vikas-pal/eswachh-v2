APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=10
LOG_LEVEL=debug

# MySQL, not the sqlite Laravel ships with: the importer reads a v1 MySQL
# database directly, and the tenancy scope leans on MySQL's join behaviour.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u841499718_eswachh_testing_v2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_ENABLED=false
RAZORPAY_KEY=
RAZORPAY_SECRET=

# How a message leaves the building, tried left to right until one takes it.
# Known: msg91.whatsapp, twilio.whatsapp, twilio.sms
#
# Unset means msg91.whatsapp alone, which is how everything has gone out so far.
# The arrangement worth having is a channel that carries a button followed by
# one that always arrives:
#
#   MESSAGING_CHAIN=twilio.whatsapp,twilio.sms
#
# Falling back is not invisible: an SMS has no button, so the renewal link is
# appended to the text, and it is billed per 160 characters.
MESSAGING_CHAIN=msg91.whatsapp

# The sign-in code, which may travel differently from everything else - it is
# the only way into an account, so it is the one message that must arrive.
# Empty means "use MESSAGING_CHAIN".
MESSAGING_LOGIN_CODE_CHAIN=

# May the scheduled jobs send messages - the renewal reminders, the daily
# summary, the "put on hold" notice?
#
# true on the LIVE site only. Leave it false on staging and on a development
# machine: those jobs run against real customer data with nobody watching, and
# with MSG91_TEST_RECIPIENT set they send every customer's reminder to the one
# test phone in the same minute, which WhatsApp then blocks as spam.
#
# Messages a person sends from a screen, receipts and sign-in codes are not
# affected. `php artisan eswachh:check-integrations` says which way this is.
SCHEDULED_MESSAGES=false

WHATSAPP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
# MSG91_AUTH_KEY is the account key (letters and digits, ~28 characters).
# MSG91_WHATSAPP_NUMBER is the WhatsApp number with its country code, digits
# only. Swapping the two is silent from our side and MSG91 answers 401 to every
# message; `php artisan eswachh:check-integrations` names it.
#
# Send every message to one number instead of to the customer, for testing on a
# live site. While it is set NO customer is messaged, so clear it afterwards.
#
# Ten digits, as every other number here is stored - the country code is added
# on the way to the provider. Twelve works too and reaches the same phone.
# MSG91_TEST_RECIPIENT=8756966569
#
# ---------------------------------------------------------------------------
# Twilio
#
# One account, two senders. Which one a message uses is MESSAGING_CHAIN above.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp-enabled Twilio number, digits only. The sandbox number
# 14155238886 cannot send templates that belong to the account.
TWILIO_WHATSAPP_FROM=
# The SMS sender: a Twilio number in E.164, or a registered sender id
TWILIO_SMS_FROM=
#
# India only, and not optional there. Every sender and template must be
# registered with the telecom regulator (DLT) through an operator before an SMS
# reaches an Indian number. Without these, Twilio accepts the message and the
# carrier drops it - which looks exactly like one that was sent.
TWILIO_DLT_ENTITY_ID=
TWILIO_DLT_TEMPLATE_ID=
#
# Twilio addresses a template by its own Content SID (HX...), not by the name
# Meta approved. One per template, copied from Content Template Builder after
# WhatsApp has approved it. A sample such as the appointment reminder is not
# one of these: it would send the wrong wording to a customer.
TWILIO_CONTENT_RENEWAL_DUE=
TWILIO_CONTENT_RENEWAL_OVERDUE=
TWILIO_CONTENT_PUT_ON_HOLD=
# Used only by `php artisan eswachh:send-whatsapp` when --content is omitted.
TWILIO_CONTENT_TEST=

# Only the template export reads this, and it already defaults to the WhatsApp
# Business account these templates belong to. Set it for a second account.
#
# Left commented rather than blank on purpose: an empty value here is an empty
# string, not "unset", so uncommenting it without filling it in would export
# every template with no namespace at all.
# MSG91_TEMPLATE_NAMESPACE=
